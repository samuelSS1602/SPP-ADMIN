rules_version = '2';

// Firestore security rules for the Sri Padmavati Pleasants admin console.
// Only signed-in staff (Firebase Authentication users) may read or write data.
// Publish: Firebase Console > Firestore Database > Rules > paste this file > Publish.
service cloud.firestore {
  match /databases/{database}/documents {

    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner() {
      return isSignedIn() && request.auth.token.email == 'sppowner@gmail.com';
    }

    // The testing login: it may only use the sandbox below, never live data.
    function isTester() {
      return isSignedIn() && request.auth.token.email == 'spp1@gmail.com';
    }

    function isLiveStaff() {
      return isSignedIn() && !isTester();
    }

    match /bookings/{bookingId}        { allow read, write: if isLiveStaff(); }
    match /booking_photos/{bookingId}  { allow read, write: if isLiveStaff(); }
    match /customers/{customerId}      { allow read, write: if isLiveStaff(); }
    match /rooms/{roomId}              { allow read, write: if isLiveStaff(); }
    match /diaryReminder/{entryId}     { allow read, write: if isLiveStaff(); }
    match /audit_logs/{logId}          { allow read, write: if isLiveStaff(); }

    // Test copy of every collection above (sandbox/test/bookings, sandbox/test/rooms, ...).
    // The tester works here; the owner may switch to it to review and reset the test data.
    match /sandbox/{document=**}       { allow read, write: if isTester() || isOwner(); }

    // Push tokens of the owner's phones (doc id = token). A phone may add or remove its own token,
    // but nobody can list them; only the /api/notify-booking function (admin SDK) reads them.
    match /owner_devices/{token}       { allow create, update, delete: if isSignedIn(); }

    // Everything else is closed.
    match /{document=**} { allow read, write: if false; }
  }
}
